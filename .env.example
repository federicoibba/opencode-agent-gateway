# Copy this file to `.env` and fill in the values below:
#
#   cp .env.example .env
#
# Docker Compose loads `.env` automatically from this directory. Never commit
# `.env` (it is already listed in .gitignore).

# Required. Your OpenCode Go API key.
#
# Where to get it: https://opencode.ai/auth -> sign in -> subscribe to Go ->
# copy the API key. It looks like `oc_sk_...`.
#
# This key is used only by the `agentgateway` container to authenticate against
# the OpenCode Go API at https://opencode.ai/zen/go/v1. It is never passed to
# the browser or to open-webui.
OPENCODE_API_KEY=oc_sk_replace_me

# --- Workspaces (optional) --------------------------------------------------
# `workspace-sync` reconciles workspaces/<domain>/ from this repo into
# open-webui's Workspace. It needs one of the two credential sets below.
#
# Option A — bootstrap the first admin headlessly (simplest for a fresh install).
# When both are set, open-webui creates this account at startup and disables open
# sign-up. Use a strong, unique password; this file is gitignored.
# WEBUI_ADMIN_EMAIL=admin@example.com
# WEBUI_ADMIN_PASSWORD=change-me

# Option B — use an API key from an existing account
# (Settings > Account > API Keys in open-webui). Leave the admin pair unset.
# OPENWEBUI_API_KEY=sk-...

